---
import { Image } from 'astro:assets';
import icon from '../assets/brand/app-icon.png';
import Icon from './Icon.astro';
import { dicts, type Lang } from '../i18n';
import { repo, download } from '../site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang].open;
---
<section class="open">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap inner" data-reveal>
    <Image class="icon" src={icon} alt="" width={224} height={224} />
    <h2 class="display section-title">{t.title}</h2>
    <p class="lede">{t.lede}</p>
    <div class="actions">
      <a class="btn btn-primary btn-lg" href={repo} rel="noopener">
        <Icon name="github" />
        {t.star}
      </a>
      <a class="btn btn-default btn-lg" href={download}>
        <Icon name="download" />
        {t.download}
      </a>
    </div>
  </div>
</section>

<style>
  .open {
    position: relative;
    padding: clamp(140px, 20vh, 220px) 0 clamp(120px, 16vh, 180px);
    overflow: clip;
  }

  .glow {
    position: absolute;
    inset: 10% 0 0;
    z-index: -1;
    background:
      radial-gradient(34% 46% at 50% 42%, var(--haze-a), transparent 70%),
      radial-gradient(24% 30% at 62% 64%, var(--haze-b), transparent 70%);
    filter: blur(24px);
  }

  .inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .inner :global(.icon) {
    width: 112px;
    height: 112px;
    margin-bottom: 32px;
    border-radius: 26px;
    box-shadow:
      0 0 0 0.5px var(--edge),
      0 2px 6px rgb(20 22 40 / 8%),
      0 30px 50px -18px rgb(70 80 190 / 45%);
    transition: transform var(--d-slow) var(--ease-pop);
  }

  .inner :global(.icon:hover) {
    transform: translateY(-4px) rotate(-3deg);
  }

  .lede {
    margin-top: 16px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 40px;
  }
</style>
