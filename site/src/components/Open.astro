---
import { Image, Picture } from 'astro:assets';
import icon from '../assets/brand/app-icon.png';
import dusk from '../assets/hero/dusk.jpg';
import morning from '../assets/hero/morning.jpg';
import Icon from './Icon.astro';
import { dicts, type Lang } from '../i18n';
import { repo, download } from '../site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang].open;
---
<section class="open">
  <div class="sky" aria-hidden="true">
    <Picture formats={['avif', 'webp']} class="art art-light" src={morning} alt="" widths={[800, 1200, 1672]} sizes="100vw" loading="lazy" />
    <Picture formats={['avif', 'webp']} class="art art-dark" src={dusk} alt="" widths={[800, 1200, 1774]} sizes="100vw" loading="lazy" />
  </div>
  <div class="wrap inner" data-reveal>
    <Image class="icon" src={icon} alt="" width={224} height={224} />
    <h2 class="display section-title">{t.title}</h2>
    {t.lede && <p class="lede">{t.lede}</p>}
    <div class="actions">
      <a class="btn btn-primary btn-lg" href={repo} rel="noopener">
        <Icon name="github" />
        {t.star}
      </a>
      <a class="btn btn-default btn-lg" href={download}>
        <Icon name="download" />
        {t.download}
      </a>
    </div>
  </div>
</section>

<style>
  .open {
    position: relative;
    padding: clamp(240px, 34vh, 360px) 0 clamp(200px, 30vh, 320px);
    overflow: clip;
  }

  /* The night sky starts higher than the morning one; less of it to fade through. */
  :global([data-theme='dark']) .open {
    padding-top: clamp(160px, 22vh, 240px);
  }

  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ground);
  }

  .sky :global(.art) {
    position: absolute;
    inset: auto 0 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
  }

  :global([data-theme='light']) .sky :global(.art-dark),
  :global([data-theme='dark']) .sky :global(.art-light) {
    display: none;
  }

  .sky::before,
  .sky::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: '';
  }

  .sky::before {
    z-index: 1;
    background: linear-gradient(180deg, var(--ground), transparent 42%);
  }

  /* Near dunes settle into one flat tone the footer sits on. */
  .sky::after {
    z-index: 1;
    background: linear-gradient(180deg, transparent 84%, color-mix(in srgb, var(--dune) 70%, transparent) 94%, var(--dune));
  }

  .inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .inner :global(.icon) {
    width: 112px;
    height: 112px;
    margin-bottom: 36px;
    filter:
      drop-shadow(0 2px 3px rgb(4 4 16 / 30%))
      drop-shadow(0 0 28px rgb(240 168 90 / 38%))
      drop-shadow(0 0 70px rgb(240 168 90 / 22%));
    transition: transform var(--d-slow) var(--ease-pop);
  }

  .inner :global(.icon:hover) {
    transform: translateY(-4px) rotate(-3deg);
  }

  .section-title {
    text-shadow: var(--sky-text-shadow);
  }

  .lede {
    margin-top: 16px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 40px;
  }
</style>
