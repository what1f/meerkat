---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import boardLight from '../assets/hero/board-light.png';
import boardDark from '../assets/hero/board-dark.png';
import { dicts, type Lang } from '../i18n';
import { repo, download } from '../site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang];
const sizes = '(max-width: 980px) 92vw, 640px';
const widths = [480, 720, 960, 1280];
---
<section class="hero">
  <div class="haze" aria-hidden="true"></div>
  <div class="wrap grid">
    <div class="copy">
      <h1 class="display title">
        <span>{t.hero.title[0]}</span>
        <span>{t.hero.title[1]}</span>
      </h1>
      <p class="sub">{t.hero.lede}</p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href={download}>
          <Icon name="download" />
          {t.hero.download}
        </a>
        <a class="btn btn-default btn-lg" href={repo} rel="noopener">
          <Icon name="github" />
          {t.hero.github}
        </a>
      </div>
    </div>

    <div class="stage" aria-hidden="true">
      <Image class="art light" src={boardLight} alt="" widths={widths} sizes={sizes} loading="eager" fetchpriority="high" />
      <Image class="art dark" src={boardDark} alt="" widths={widths} sizes={sizes} loading="eager" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: calc(var(--nav-h) + clamp(40px, 9vh, 104px)) 0 clamp(72px, 12vh, 140px);
    overflow: clip;
  }

  .haze {
    position: absolute;
    inset: -20% -10% auto;
    z-index: -1;
    height: 120%;
    background:
      radial-gradient(40% 50% at 18% 18%, var(--haze-a), transparent 70%),
      radial-gradient(36% 44% at 34% 74%, var(--haze-b), transparent 70%),
      radial-gradient(50% 60% at 85% 10%, var(--haze-c), transparent 70%);
    filter: blur(20px);
    mask: linear-gradient(#000 55%, transparent);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(24px, 3vw, 48px);
    align-items: center;
  }

  .title {
    font-size: var(--fs-display);
  }

  .title span {
    display: block;
    white-space: nowrap;
  }

  .sub {
    max-width: 24em;
    margin: 20px 0 0;
    font-size: var(--fs-lede);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .copy > * {
    animation: rise 0.9s var(--ease) both;
  }

  .copy > :nth-child(2) {
    animation-delay: 80ms;
  }

  .copy > :nth-child(3) {
    animation-delay: 160ms;
  }

  .stage {
    position: relative;
    width: min(640px, 48vw);
    animation: float-in 1.1s var(--ease) 0.15s both;
  }

  .stage :global(.art) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 30px 40px rgb(20 22 40 / 14%));
  }

  .stage :global(.art.dark) {
    display: none;
  }

  :global([data-theme='dark']) .stage :global(.art.light) {
    display: none;
  }

  :global([data-theme='dark']) .stage :global(.art.dark) {
    display: block;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 50%));
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .sub {
      margin-inline: auto;
    }

    .actions {
      justify-content: center;
    }

    .stage {
      width: min(560px, 100%);
      margin: 16px auto 0;
    }
  }
</style>
