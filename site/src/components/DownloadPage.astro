---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import icon from '../assets/brand/app-icon.png';
import { dicts, type Lang } from '../i18n';
import { getLatestRelease, latestReleaseApi } from '../site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = dicts[lang].downloadPage;
const release = await getLatestRelease();

const payload = {
  api: latestReleaseApi,
  release,
  copy: d,
};
---
<Base lang={lang} page="download" title={d.metaTitle}>
  <div class="shell" data-dl-page>
    <script type="application/json" data-dl-payload set:html={JSON.stringify(payload)} />
    <Nav lang={lang} page="download" />

    <main class="main">
      <div class="wrap center">
        <Image class="icon" src={icon} alt="" width={160} height={160} />
        <h1 class="display title">{d.title}</h1>
        <p class="sub">
          <span class="mono" data-release-tag>{release.tag}</span>
          <span aria-hidden="true">·</span>
          <span data-dl-sub>{d.subDefault}</span>
        </p>

        <div class="picker-stage">
          <div class="platform-wrap">
            <button
              type="button"
              class="platform-trigger"
              data-platform-trigger
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-label={d.choosePlatform}
            >
              <span class="os-icon" data-selected-icon="apple"><Icon name="apple" size={15} /></span>
              <span class="os-icon" data-selected-icon="windows" hidden><Icon name="windows" size={14} /></span>
              <span class="os-icon" data-selected-icon="linux" hidden><Icon name="linux" size={15} /></span>
              <span class="os" data-selected-os>{d.osMac}</span>
              <span class="arch" data-selected-arch>{d.archArm}</span>
              <Icon name="chevron-down" size={14} class="chev" />
            </button>

            <div
              class="platform-menu"
              role="listbox"
              aria-label={d.choosePlatform}
              data-platform-menu
              data-open="false"
            >
              <button
                type="button"
                class="platform-opt"
                role="option"
                aria-selected="true"
                data-platform-option="macos-arm64"
              >
                <span class="opt-icon" aria-hidden="true">
                  <Icon name="apple" size={16} />
                </span>
                <span class="opt-label">
                  <span class="os">{d.osMac}</span>
                  <span class="arch">{d.archArm}</span>
                </span>
                <span class="opt-check" aria-hidden="true">
                  <Icon name="check" size={14} />
                </span>
              </button>

              <button
                type="button"
                class="platform-opt"
                role="option"
                aria-selected="false"
                data-platform-option="macos-x86_64"
              >
                <span class="opt-icon" aria-hidden="true"></span>
                <span class="opt-label">
                  <span class="os">{d.osMac}</span>
                  <span class="arch">{d.archIntel}</span>
                </span>
                <span class="opt-check" aria-hidden="true">
                  <Icon name="check" size={14} />
                </span>
              </button>

              <button
                type="button"
                class="platform-opt"
                role="option"
                aria-selected="false"
                data-platform-option="windows-x86_64"
              >
                <span class="opt-icon" aria-hidden="true">
                  <Icon name="windows" size={14} />
                </span>
                <span class="opt-label">
                  <span class="os">{d.osWindows}</span>
                  <span class="arch">{d.archX64}</span>
                </span>
                <span class="opt-check" aria-hidden="true">
                  <Icon name="check" size={14} />
                </span>
              </button>

              <button
                type="button"
                class="platform-opt"
                role="option"
                aria-selected="false"
                data-platform-option="linux-x86_64"
              >
                <span class="opt-icon" aria-hidden="true">
                  <Icon name="linux" size={15} />
                </span>
                <span class="opt-label">
                  <span class="os">{d.osLinux}</span>
                  <span class="arch">{d.archX64}</span>
                </span>
                <span class="opt-check" aria-hidden="true">
                  <Icon name="check" size={14} />
                </span>
              </button>

              <button
                type="button"
                class="platform-opt"
                role="option"
                aria-selected="false"
                data-platform-option="linux-arm64"
              >
                <span class="opt-icon" aria-hidden="true"></span>
                <span class="opt-label">
                  <span class="os">{d.osLinux}</span>
                  <span class="arch">{d.archArm64}</span>
                </span>
                <span class="opt-check" aria-hidden="true">
                  <Icon name="check" size={14} />
                </span>
              </button>
            </div>
          </div>

          <a
            class="btn btn-primary btn-lg download-cta"
            href={release.assets['macos-arm64'] ?? release.htmlUrl}
            data-primary-download
          >
            <span>{d.cta}</span>
            <Icon name="download" size={17} />
          </a>
        </div>

        <p class="more">
          <a href={release.htmlUrl} rel="noopener" data-release-page>
            <span>{d.releasesLink}</span>
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </main>

    <Footer lang={lang} page="download" flat />
  </div>
</Base>

<script>
  import { detectPlatform, type DetectedPlatform } from '../lib/platform';
  import { parseGitHubRelease, type AssetKey, type ReleaseInfo } from '../lib/release';

  interface Payload {
    api: string;
    release: ReleaseInfo;
    copy: {
      subDefault: string;
      subWindows: string;
      subLinux: string;
      osMac: string;
      osWindows: string;
      osLinux: string;
      archArm: string;
      archIntel: string;
      archX64: string;
      archArm64: string;
    };
  }

  const ASSET_KEYS: AssetKey[] = [
    'macos-arm64',
    'macos-x86_64',
    'windows-x86_64',
    'linux-x86_64',
    'linux-arm64',
  ];

  const CACHE_KEY = 'meerkat-latest-release-v2';
  const CACHE_TTL_MS = 15 * 60 * 1000;

  const root = document.querySelector<HTMLElement>('[data-dl-page]');
  const payloadEl = root?.querySelector<HTMLScriptElement>('[data-dl-payload]');

  if (root && payloadEl?.textContent) {
    const payload = JSON.parse(payloadEl.textContent) as Payload;
    let release = payload.release;
    const { copy } = payload;

    let selected: AssetKey = 'macos-arm64';
    let detected: DetectedPlatform = 'other';
    let userPicked = false;
    let menuOpen = false;

    const sub = root.querySelector<HTMLElement>('[data-dl-sub]');
    const trigger = root.querySelector<HTMLButtonElement>('[data-platform-trigger]');
    const selectedOsEl = root.querySelector<HTMLElement>('[data-selected-os]');
    const selectedArchEl = root.querySelector<HTMLElement>('[data-selected-arch]');
    const selectedIcons = Array.from(root.querySelectorAll<HTMLElement>('[data-selected-icon]'));
    const menu = root.querySelector<HTMLElement>('[data-platform-menu]');
    const options = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-platform-option]'));
    const primaryLink = root.querySelector<HTMLAnchorElement>('[data-primary-download]');

    function metaFor(key: AssetKey): { os: string; arch: string; icon: string; sub: string } {
      switch (key) {
        case 'macos-x86_64':
          return { os: copy.osMac, arch: copy.archIntel, icon: 'apple', sub: copy.subDefault };
        case 'windows-x86_64':
          return { os: copy.osWindows, arch: copy.archX64, icon: 'windows', sub: copy.subWindows };
        case 'linux-x86_64':
          return { os: copy.osLinux, arch: copy.archX64, icon: 'linux', sub: copy.subLinux };
        case 'linux-arm64':
          return { os: copy.osLinux, arch: copy.archArm64, icon: 'linux', sub: copy.subLinux };
        default:
          return { os: copy.osMac, arch: copy.archArm, icon: 'apple', sub: copy.subDefault };
      }
    }

    function availableKeys(): AssetKey[] {
      return ASSET_KEYS.filter((key) => Boolean(release.assets[key]));
    }

    function applySelection() {
      const available = availableKeys();
      if (available.length > 0 && !release.assets[selected]) {
        selected = available[0];
      }
      const meta = metaFor(selected);
      if (selectedOsEl) selectedOsEl.textContent = meta.os;
      if (selectedArchEl) selectedArchEl.textContent = meta.arch;
      if (sub) sub.textContent = meta.sub;
      selectedIcons.forEach((el) => {
        el.hidden = el.dataset.selectedIcon !== meta.icon;
      });
      if (primaryLink) {
        primaryLink.href = release.assets[selected] ?? release.htmlUrl;
      }
      options.forEach((opt) => {
        const key = opt.dataset.platformOption as AssetKey | undefined;
        const hasAsset = Boolean(key && release.assets[key]);
        opt.hidden = !hasAsset;
        const isCurrent = opt.dataset.platformOption === selected;
        opt.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
      });
    }

    function applyRelease() {
      root!.querySelectorAll<HTMLElement>('[data-release-tag]').forEach((el) => {
        el.textContent = release.tag;
      });
      root!.querySelectorAll<HTMLAnchorElement>('[data-release-page]').forEach((el) => {
        el.href = release.htmlUrl;
      });
      if (!userPicked && detected !== 'other' && release.assets[detected]) {
        selected = detected;
      }
      applySelection();
    }

    function setMenuOpen(open: boolean) {
      menuOpen = open;
      trigger?.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (menu) {
        menu.dataset.open = open ? 'true' : 'false';
      }
    }

    function applyPlatform(platform: DetectedPlatform) {
      detected = platform;
      if (!userPicked && platform !== 'other' && release.assets[platform]) {
        selected = platform;
        applySelection();
      }
    }

    trigger?.addEventListener('click', (event) => {
      event.stopPropagation();
      setMenuOpen(!menuOpen);
      if (menuOpen) {
        const visible = options.filter((opt) => !opt.hidden);
        const activeOption = visible.find((opt) => opt.dataset.platformOption === selected) ?? visible[0];
        activeOption?.focus();
      }
    });

    options.forEach((opt) => {
      opt.addEventListener('click', () => {
        const key = opt.dataset.platformOption as AssetKey | undefined;
        if (key && ASSET_KEYS.includes(key) && release.assets[key]) {
          selected = key;
          userPicked = true;
          applySelection();
        }
        setMenuOpen(false);
        trigger?.focus();
      });

      opt.addEventListener('keydown', (event) => {
        const visible = options.filter((item) => !item.hidden);
        const idx = visible.indexOf(opt);
        if (idx < 0) return;
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          visible[(idx + 1) % visible.length]?.focus();
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          visible[(idx - 1 + visible.length) % visible.length]?.focus();
        } else if (event.key === 'Escape') {
          event.preventDefault();
          setMenuOpen(false);
          trigger?.focus();
        }
      });
    });

    document.addEventListener('click', (event) => {
      if (!menuOpen) return;
      const target = event.target as Node | null;
      if (target && (menu?.contains(target) || trigger?.contains(target))) return;
      setMenuOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuOpen) {
        setMenuOpen(false);
        trigger?.focus();
      }
    });

    applyRelease();
    detectPlatform().then(applyPlatform);

    (async () => {
      try {
        const cachedRaw = sessionStorage.getItem(CACHE_KEY);
        if (cachedRaw) {
          const cached = JSON.parse(cachedRaw) as { at: number; release: ReleaseInfo };
          if (Date.now() - cached.at < CACHE_TTL_MS && cached.release?.tag) {
            release = cached.release;
            applyRelease();
            return;
          }
        }
      } catch {
        // Ignore storage errors.
      }

      try {
        const res = await fetch(payload.api, {
          headers: { Accept: 'application/vnd.github+json' },
          signal: AbortSignal.timeout(4000),
        });
        if (!res.ok) return;
        const parsed = parseGitHubRelease(await res.json());
        if (!parsed) return;
        release = parsed;
        try {
          sessionStorage.setItem(CACHE_KEY, JSON.stringify({ at: Date.now(), release: parsed }));
        } catch {
          // Ignore quota errors.
        }
        applyRelease();
      } catch {
        // Keep build-time fallback silently.
      }
    })();
  }
</script>

<style>
  .shell {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  .main {
    display: flex;
    flex: 1;
    align-items: center;
    padding: calc(var(--nav-h) + 32px) 0 80px;
  }

  .center {
    text-align: center;
  }

  .center :global(.icon) {
    width: 72px;
    height: 72px;
    margin: 0 auto 22px;
    filter: drop-shadow(0 2px 6px rgb(4 4 16 / 20%));
  }

  .title {
    font-size: clamp(34px, 4.4vw, 52px);
  }

  .sub {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin: 12px 0 0;
    font-size: var(--fs-body);
    color: var(--ink-2);
  }

  .picker-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 28px;
  }

  .platform-wrap {
    position: relative;
  }

  .platform-trigger {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    height: 36px;
    padding: 0 14px;
    font-size: var(--fs-body);
    color: var(--ink);
    cursor: pointer;
    background: none;
    border: 0;
    border-radius: 999px;
    transition:
      background-color var(--d-fast) var(--ease),
      box-shadow var(--d-fast) var(--ease);
  }

  .platform-trigger:hover,
  .platform-trigger[aria-expanded='true'] {
    background: var(--hover);
  }

  .platform-trigger:focus-visible {
    outline: none;
    box-shadow: var(--ring-focus);
  }

  .platform-trigger .os {
    font-weight: 500;
    color: var(--ink);
  }

  .platform-trigger .arch {
    color: var(--ink-2);
  }

  .platform-trigger :global(.chev) {
    color: var(--ink-3);
    transition: transform var(--d-fast) var(--ease);
  }

  .platform-trigger[aria-expanded='true'] :global(.chev) {
    transform: rotate(180deg);
  }

  .platform-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 248px;
    padding: 6px;
    background: var(--surface);
    border: var(--hairline) solid var(--line-strong);
    border-radius: 16px;
    box-shadow: var(--shadow-3);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, -4px) scale(0.98);
    transform-origin: top center;
    transition:
      opacity var(--d-fast) var(--ease),
      transform var(--d-fast) var(--ease),
      visibility 0s linear var(--d-fast);
  }

  .platform-menu[data-open='true'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0) scale(1);
    transition:
      opacity var(--d-fast) var(--ease),
      transform var(--d-fast) var(--ease),
      visibility 0s linear 0s;
  }

  .platform-opt {
    display: grid;
    grid-template-columns: 20px 1fr 16px;
    gap: 10px;
    align-items: center;
    width: 100%;
    padding: 9px 12px;
    font-size: var(--fs-body);
    text-align: left;
    cursor: pointer;
    background: none;
    border: 0;
    border-radius: 10px;
    transition: background-color var(--d-fast) var(--ease);
  }

  .platform-opt[hidden],
  .os-icon[hidden] {
    display: none;
  }

  .platform-opt:hover,
  .platform-opt:focus-visible {
    outline: none;
    background: var(--hover);
  }

  .opt-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
  }

  .opt-label {
    display: inline-flex;
    gap: 6px;
    align-items: baseline;
    white-space: nowrap;
  }

  .opt-label .os {
    font-weight: 500;
    color: var(--ink);
  }

  .opt-label .arch {
    color: var(--ink-2);
  }

  .opt-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-2);
    opacity: 0;
    transition: opacity var(--d-fast) var(--ease);
  }

  .platform-opt[aria-selected='true'] {
    background: var(--field);
  }

  .platform-opt[aria-selected='true'] .opt-check {
    opacity: 1;
  }

  .download-cta {
    min-width: 164px;
    margin-top: 10px;
  }

  .more {
    margin: 28px 0 0;
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .more a {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    padding: 6px 12px;
    border-radius: 999px;
    transition:
      color var(--d-fast) var(--ease),
      background-color var(--d-fast) var(--ease);
  }

  .more a:hover {
    color: var(--ink);
    background: var(--hover);
  }
</style>
