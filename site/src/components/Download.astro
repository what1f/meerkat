---
import Icon from './Icon.astro';
import { dicts, type Lang } from '../i18n';
import { formatBytes, installCommand } from '../lib/release';
import { getLatestRelease, latestReleaseApi } from '../site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = dicts[lang].downloadSection;
const release = await getLatestRelease();
const defaultTarget = 'macos-arm64' as const;
const defaultAsset = release.assets[defaultTarget];
const defaultCopy = d.targets[defaultTarget];
const shellCommand = installCommand(release.assets['install-sh'].url);

const payload = {
  api: latestReleaseApi,
  release,
  copy: d,
};
---
<section class="download" id="download" data-download-section>
  <script type="application/json" data-download-payload set:html={JSON.stringify(payload)} />
  <div class="wrap">
    <header class="head" data-reveal>
      <h2 class="display section-title">{d.title}</h2>
      <p class="lede">{d.lede}</p>
    </header>

    <div class="spotlight" data-reveal data-spotlight>
      <div class="spot-main">
        <div class="spot-badges">
          <span class="pill pill-accent" data-spot-badge>{d.recommendedBadge}</span>
          <span class="pill mono" data-release-version>{release.tag}</span>
          <span class="spot-chip" data-spot-chip>{defaultCopy.chip}</span>
        </div>
        <h3 class="spot-title" data-spot-title>{defaultCopy.title}</h3>
        <p class="spot-desc" data-spot-desc>{defaultCopy.desc}</p>
        <div class="spot-file" data-spot-file>
          <span class="mono" data-spot-filename>{defaultAsset.name}</span>
          <span class="dot" aria-hidden="true">·</span>
          <span class="mono" data-spot-size>{formatBytes(defaultAsset.bytes)}</span>
        </div>
        <p class="spot-hint" data-spot-hint hidden>
          <span data-spot-hint-text>{d.ambiguousMacNote}</span>
          <button type="button" class="inline-switch" data-spot-switch>{d.switchToIntel}</button>
        </p>
      </div>

      <div class="spot-cta">
        <a class="btn btn-primary btn-lg" href={defaultAsset.url} data-spot-cta>
          <Icon name="download" />
          <span data-spot-cta-label>{defaultCopy.cta}</span>
        </a>
        <div class="switch-row" role="group" aria-label={d.allDownloads}>
          <button type="button" class="chip-btn" data-select-target="macos-arm64" aria-pressed="true">
            Apple Silicon
          </button>
          <button type="button" class="chip-btn" data-select-target="macos-x86_64" aria-pressed="false">
            Intel Mac
          </button>
          <button type="button" class="chip-btn" data-select-target="linux-x86_64" aria-pressed="false">
            Linux x86_64
          </button>
          <button type="button" class="chip-btn" data-select-target="linux-arm64" aria-pressed="false">
            Linux ARM64
          </button>
        </div>
      </div>
    </div>

    <div class="groups" data-reveal style="--delay:90ms">
      <article class="card">
        <div class="card-head">
          <div class="card-icon"><Icon name="apple" size={20} /></div>
          <div>
            <h3 class="card-title">{d.desktopGroupTitle}</h3>
            <p class="card-desc">{d.desktopGroupDesc}</p>
          </div>
        </div>

        <ul class="rows">
          {(['macos-arm64', 'macos-x86_64'] as const).map((key) => {
            const info = d.targets[key];
            const asset = release.assets[key];
            return (
              <li class="row" data-asset-row={key} data-recommended={key === 'macos-arm64' ? 'true' : 'false'}>
                <div class="row-info">
                  <div class="row-title">
                    <span>{info.short}</span>
                    <span class="mini-badge" data-row-badge={key} hidden={key !== 'macos-arm64'}>
                      {d.recommendedBadge}
                    </span>
                  </div>
                  <div class="row-meta mono">
                    <span data-asset-name={key}>{asset.name}</span>
                    <span>·</span>
                    <span data-asset-size={key}>{formatBytes(asset.bytes)}</span>
                  </div>
                </div>
                <a class="btn btn-default btn-sm" href={asset.url} data-asset-url={key}>
                  <Icon name="download" size={16} />
                  <span>.dmg</span>
                </a>
              </li>
            );
          })}
          <li class="row row-muted">
            <div class="row-info">
              <div class="row-title">{d.comingSoonLabel}</div>
              <p class="row-note">{d.comingSoonNote}</p>
            </div>
          </li>
        </ul>
      </article>

      <article class="card">
        <div class="card-head">
          <div class="card-icon"><Icon name="terminal" size={20} /></div>
          <div>
            <h3 class="card-title">{d.nodeGroupTitle}</h3>
            <p class="card-desc">{d.nodeGroupDesc}</p>
          </div>
        </div>

        <div class="cmd-box">
          <div class="cmd-top">
            <span class="cmd-label">{d.nodeInstallLabel}</span>
            <button type="button" class="copy-btn" data-copy-cmd>
              <span class="copy-icon-default"><Icon name="copy" size={14} /></span>
              <span class="copy-icon-ok" hidden><Icon name="check" size={14} /></span>
              <span data-copy-label>{d.copyCmd}</span>
            </button>
          </div>
          <pre class="cmd-code mono" data-install-cmd>{shellCommand}</pre>
        </div>

        <p class="manual-label">{d.nodeManualLabel}</p>
        <div class="node-links">
          {d.nodeItems.map((item) => {
            const key = item.key as keyof typeof release.assets;
            const asset = release.assets[key];
            return (
              <a
                class="node-link"
                href={asset.url}
                data-asset-url={key}
                data-asset-row={key}
                data-recommended="false"
              >
                <span class="node-name">{item.label}</span>
                <span class="node-meta mono">
                  <span data-asset-size={key}>{formatBytes(asset.bytes)}</span>
                  <span>.tar.gz</span>
                </span>
              </a>
            );
          })}
        </div>
      </article>
    </div>

    <p class="release-foot" data-reveal style="--delay:150ms">
      <a href={release.htmlUrl} rel="noopener" data-release-page>
        <span>{d.releaseNotes}</span>
        <span class="mono" data-release-version>{release.tag}</span>
        <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<script>
  import { detectPlatform, type DetectedTarget, type SelectableTarget } from '../lib/platform';
  import {
    formatBytes,
    installCommand,
    parseGitHubRelease,
    type AssetKey,
    type ReleaseInfo,
  } from '../lib/release';

  interface TargetCopy {
    short: string;
    chip: string;
    title: string;
    desc: string;
    cta: string;
  }

  interface DownloadPayload {
    api: string;
    release: ReleaseInfo;
    copy: {
      recommendedBadge: string;
      selectedBadge: string;
      ambiguousMacNote: string;
      switchToIntel: string;
      switchToArm: string;
      heroMacLabel: string;
      heroLinuxLabel: string;
      heroMacPrefix: string;
      heroLinuxNote: string;
      heroWindowsNote: string;
      heroMobileNote: string;
      copyCmd: string;
      copiedCmd: string;
      targets: Record<SelectableTarget | 'windows' | 'mobile', TargetCopy>;
    };
  }

  const CACHE_KEY = 'meerkat-latest-release-v1';
  const CACHE_TTL_MS = 15 * 60 * 1000;

  function initDownloads() {
    const section = document.querySelector<HTMLElement>('[data-download-section]');
    const payloadEl = section?.querySelector<HTMLScriptElement>('[data-download-payload]');
    if (!section || !payloadEl?.textContent) return;

    const payload = JSON.parse(payloadEl.textContent) as DownloadPayload;
    let release = payload.release;
    const { copy } = payload;

    let detectedTarget: DetectedTarget = 'unknown';
    let detectedRecommended: SelectableTarget = 'macos-arm64';
    let selectedTarget: SelectableTarget = 'macos-arm64';
    let ambiguousMacArch = false;
    let manualOverride = false;

    const heroBtn = document.querySelector<HTMLAnchorElement>('[data-hero-download]');
    const heroBtnLabel = document.querySelector<HTMLElement>('[data-hero-download-label]');
    const heroMeta = document.querySelector<HTMLElement>('[data-hero-meta]');
    const heroMetaText = document.querySelector<HTMLElement>('[data-hero-meta-text]');
    const heroSwitch = document.querySelector<HTMLButtonElement>('[data-hero-switch]');

    const spotBadge = section.querySelector<HTMLElement>('[data-spot-badge]');
    const spotChip = section.querySelector<HTMLElement>('[data-spot-chip]');
    const spotTitle = section.querySelector<HTMLElement>('[data-spot-title]');
    const spotDesc = section.querySelector<HTMLElement>('[data-spot-desc]');
    const spotFile = section.querySelector<HTMLElement>('[data-spot-file]');
    const spotFilename = section.querySelector<HTMLElement>('[data-spot-filename]');
    const spotSize = section.querySelector<HTMLElement>('[data-spot-size]');
    const spotHint = section.querySelector<HTMLElement>('[data-spot-hint]');
    const spotHintText = section.querySelector<HTMLElement>('[data-spot-hint-text]');
    const spotSwitch = section.querySelector<HTMLButtonElement>('[data-spot-switch]');
    const spotCta = section.querySelector<HTMLAnchorElement>('[data-spot-cta]');
    const spotCtaLabel = section.querySelector<HTMLElement>('[data-spot-cta-label]');
    const copyBtn = section.querySelector<HTMLButtonElement>('[data-copy-cmd]');
    const copyLabel = section.querySelector<HTMLElement>('[data-copy-label]');
    const copyIconDefault = section.querySelector<HTMLElement>('.copy-icon-default');
    const copyIconOk = section.querySelector<HTMLElement>('.copy-icon-ok');
    const cmdPre = section.querySelector<HTMLElement>('[data-install-cmd]');

    function renderReleaseAssets() {
      section!.querySelectorAll<HTMLElement>('[data-release-version]').forEach((el) => {
        el.textContent = release.tag;
      });
      section!.querySelectorAll<HTMLAnchorElement>('[data-release-page]').forEach((el) => {
        el.href = release.htmlUrl;
      });
      (Object.keys(release.assets) as AssetKey[]).forEach((key) => {
        const asset = release.assets[key];
        section!.querySelectorAll<HTMLAnchorElement>(`[data-asset-url="${key}"]`).forEach((el) => {
          el.href = asset.url;
        });
        section!.querySelectorAll<HTMLElement>(`[data-asset-name="${key}"]`).forEach((el) => {
          el.textContent = asset.name;
        });
        section!.querySelectorAll<HTMLElement>(`[data-asset-size="${key}"]`).forEach((el) => {
          el.textContent = formatBytes(asset.bytes);
        });
      });
      if (cmdPre) {
        cmdPre.textContent = installCommand(release.assets['install-sh'].url);
      }
    }

    function renderSelection() {
      const showingUnsupported =
        !manualOverride && (detectedTarget === 'windows' || detectedTarget === 'mobile');
      const spotlightKey: SelectableTarget | 'windows' | 'mobile' = showingUnsupported
        ? (detectedTarget as 'windows' | 'mobile')
        : selectedTarget;
      const asset = release.assets[selectedTarget];
      const targetCopy = copy.targets[spotlightKey];
      const sizeStr = formatBytes(asset.bytes);

      if (spotBadge) {
        spotBadge.textContent =
          !manualOverride || selectedTarget === detectedRecommended
            ? copy.recommendedBadge
            : copy.selectedBadge;
      }
      if (spotChip) spotChip.textContent = targetCopy.chip;
      if (spotTitle) spotTitle.textContent = targetCopy.title;
      if (spotDesc) spotDesc.textContent = targetCopy.desc;
      if (spotFile) spotFile.hidden = false;
      if (spotFilename) spotFilename.textContent = asset.name;
      if (spotSize) spotSize.textContent = sizeStr;
      if (spotCta) spotCta.href = asset.url;
      if (spotCtaLabel) spotCtaLabel.textContent = targetCopy.cta;

      const showMacHint =
        !showingUnsupported &&
        (selectedTarget === 'macos-arm64' || selectedTarget === 'macos-x86_64') &&
        ambiguousMacArch;
      if (spotHint) spotHint.hidden = !showMacHint;
      if (spotHintText) spotHintText.textContent = copy.ambiguousMacNote;
      if (spotSwitch) {
        spotSwitch.textContent =
          selectedTarget === 'macos-arm64' ? copy.switchToIntel : copy.switchToArm;
      }

      section!.querySelectorAll<HTMLButtonElement>('[data-select-target]').forEach((btn) => {
        const isCurrent = btn.dataset.selectTarget === selectedTarget && !showingUnsupported;
        btn.setAttribute('aria-pressed', String(isCurrent));
      });

      section!.querySelectorAll<HTMLElement>('[data-asset-row]').forEach((row) => {
        const isRec = row.dataset.assetRow === selectedTarget && !showingUnsupported;
        row.dataset.recommended = String(isRec);
      });
      section!.querySelectorAll<HTMLElement>('[data-row-badge]').forEach((badge) => {
        badge.hidden = badge.dataset.rowBadge !== selectedTarget || showingUnsupported;
      });

      // Update Hero CTA cleanly without changing layout height excessively.
      if (heroBtn && heroBtnLabel && heroMeta && heroMetaText && heroSwitch) {
        const isMacActive =
          manualOverride
            ? selectedTarget.startsWith('macos-')
            : detectedTarget === 'macos-arm64' || detectedTarget === 'macos-x86_64';

        if (isMacActive && (selectedTarget === 'macos-arm64' || selectedTarget === 'macos-x86_64')) {
          const macAsset = release.assets[selectedTarget];
          heroBtn.href = macAsset.url;
          heroBtnLabel.textContent = copy.heroMacLabel;
          heroMetaText.textContent = `${copy.heroMacPrefix} ${copy.targets[selectedTarget].short} · ${formatBytes(macAsset.bytes)} · ${release.tag}`;
          heroSwitch.textContent =
            selectedTarget === 'macos-arm64' ? copy.switchToIntel : copy.switchToArm;
          heroSwitch.hidden = false;
          heroMeta.hidden = false;
        } else if (detectedTarget === 'linux-x86_64' || detectedTarget === 'linux-arm64') {
          heroBtn.href = '#download';
          heroBtnLabel.textContent = copy.heroLinuxLabel;
          heroMetaText.textContent = copy.heroLinuxNote;
          heroSwitch.hidden = true;
          heroMeta.hidden = false;
        } else if (detectedTarget === 'windows') {
          heroBtn.href = '#download';
          heroMetaText.textContent = copy.heroWindowsNote;
          heroSwitch.hidden = true;
          heroMeta.hidden = false;
        } else if (detectedTarget === 'mobile') {
          heroBtn.href = '#download';
          heroMetaText.textContent = copy.heroMobileNote;
          heroSwitch.hidden = true;
          heroMeta.hidden = false;
        }
      }
    }

    function switchTarget(next: SelectableTarget) {
      manualOverride = true;
      selectedTarget = next;
      ambiguousMacArch = false;
      renderSelection();
    }

    function flipMacArch() {
      switchTarget(selectedTarget === 'macos-arm64' ? 'macos-x86_64' : 'macos-arm64');
    }

    section.querySelectorAll<HTMLButtonElement>('[data-select-target]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.selectTarget as SelectableTarget | undefined;
        if (next) switchTarget(next);
      });
    });

    spotSwitch?.addEventListener('click', flipMacArch);
    heroSwitch?.addEventListener('click', flipMacArch);

    copyBtn?.addEventListener('click', async () => {
      const text = cmdPre?.textContent?.trim();
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        if (copyLabel) copyLabel.textContent = copy.copiedCmd;
        if (copyIconDefault) copyIconDefault.hidden = true;
        if (copyIconOk) copyIconOk.hidden = false;
        window.setTimeout(() => {
          if (copyLabel) copyLabel.textContent = copy.copyCmd;
          if (copyIconDefault) copyIconDefault.hidden = false;
          if (copyIconOk) copyIconOk.hidden = true;
        }, 1800);
      } catch {
        // Fallback: select text so the user can Cmd+C.
        if (cmdPre) {
          const range = document.createRange();
          range.selectNodeContents(cmdPre);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
      }
    });

    renderReleaseAssets();
    detectPlatform().then((result) => {
      detectedTarget = result.target;
      detectedRecommended = result.selected;
      selectedTarget = result.selected;
      ambiguousMacArch = result.ambiguousMacArch;
      renderSelection();
    });

    // Refresh latest release metadata in the background so future tags stay current without a site rebuild.
    (async () => {
      try {
        const cachedRaw = sessionStorage.getItem(CACHE_KEY);
        if (cachedRaw) {
          const cached = JSON.parse(cachedRaw) as { at: number; release: ReleaseInfo };
          if (Date.now() - cached.at < CACHE_TTL_MS && cached.release?.tag) {
            release = cached.release;
            renderReleaseAssets();
            renderSelection();
            return;
          }
        }
      } catch {
        // Ignore storage errors.
      }

      try {
        const res = await fetch(payload.api, {
          headers: { Accept: 'application/vnd.github+json' },
          signal: AbortSignal.timeout(4000),
        });
        if (!res.ok) return;
        const parsed = parseGitHubRelease(await res.json());
        if (!parsed) return;
        release = parsed;
        try {
          sessionStorage.setItem(CACHE_KEY, JSON.stringify({ at: Date.now(), release: parsed }));
        } catch {
          // Ignore storage quota errors.
        }
        renderReleaseAssets();
        renderSelection();
      } catch {
        // Keep build-time release fallback silently.
      }
    })();
  }

  initDownloads();
</script>

<style>
  .download {
    padding: clamp(96px, 14vh, 160px) 0 0;
  }

  .head {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .head .lede {
    margin-top: 14px;
  }

  .spotlight {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 32px;
    align-items: center;
    justify-content: space-between;
    padding: clamp(24px, 3vw, 36px);
    margin-top: clamp(36px, 5vh, 56px);
    background: var(--surface);
    border-radius: 22px;
    box-shadow: var(--shadow-2);
  }

  .spot-main {
    flex: 1 1 360px;
    min-width: 0;
  }

  .spot-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-2);
    background: var(--well);
    border-radius: 999px;
    box-shadow: inset 0 0 0 var(--hairline) var(--line-strong);
  }

  .pill-accent {
    color: var(--accent);
    background: var(--accent-soft);
    box-shadow: none;
  }

  .spot-chip {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .spot-title {
    margin: 14px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 600;
    line-height: 1.3;
  }

  .spot-desc {
    margin: 8px 0 0;
    font-size: var(--fs-body);
    color: var(--ink-2);
  }

  .spot-file {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding: 5px 12px;
    margin-top: 14px;
    font-size: var(--fs-small);
    color: var(--ink-2);
    background: var(--well);
    border-radius: 8px;
  }

  .spot-hint {
    margin: 12px 0 0;
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .spot-hint[hidden] {
    display: none;
  }

  .inline-switch {
    padding: 0;
    margin-left: 4px;
    font: inherit;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    background: none;
    border: none;
    border-bottom: 1px solid var(--line-strong);
  }

  .spot-cta {
    display: flex;
    flex: 0 1 auto;
    flex-direction: column;
    gap: 12px;
    align-items: flex-end;
  }

  .switch-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
  }

  .chip-btn {
    height: 28px;
    padding: 0 11px;
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-2);
    cursor: pointer;
    background: var(--well);
    border: none;
    border-radius: 999px;
    box-shadow: inset 0 0 0 var(--hairline) var(--line);
    transition:
      background-color var(--d-fast) var(--ease),
      color var(--d-fast) var(--ease),
      box-shadow var(--d-fast) var(--ease);
  }

  .chip-btn:hover {
    color: var(--ink);
    background: var(--hover);
  }

  .chip-btn[aria-pressed='true'] {
    color: var(--on-ink);
    background: var(--ink);
    box-shadow: none;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
    margin-top: clamp(16px, 2vw, 24px);
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 2.5vw, 28px);
    background: var(--surface);
    border-radius: 20px;
    box-shadow: var(--shadow-1);
  }

  .card-head {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .card-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    color: var(--ink);
    background: var(--well);
    border-radius: 11px;
    box-shadow: inset 0 0 0 var(--hairline) var(--line);
  }

  .card-title {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
  }

  .card-desc {
    margin: 4px 0 0;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .rows {
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 20px 0 0;
    list-style: none;
  }

  .row {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    background: var(--well);
    border-radius: 12px;
    box-shadow: inset 0 0 0 var(--hairline) var(--line);
    transition: box-shadow var(--d-fast) var(--ease);
  }

  .row[data-recommended='true'] {
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }

  .row-muted {
    background: transparent;
    box-shadow: inset 0 0 0 var(--hairline) var(--line);
  }

  .row-info {
    min-width: 0;
  }

  .row-title {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: var(--fs-body);
    font-weight: 500;
  }

  .mini-badge {
    padding: 1px 7px;
    font-size: 11px;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
  }

  .mini-badge[hidden] {
    display: none;
  }

  .row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 3px;
    font-size: 12px;
    color: var(--ink-3);
    word-break: break-all;
  }

  .row-note {
    margin: 4px 0 0;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-3);
  }

  .cmd-box {
    padding: 12px 14px;
    margin-top: 20px;
    background: var(--well);
    border-radius: 12px;
    box-shadow: inset 0 0 0 var(--hairline) var(--line);
  }

  .cmd-top {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
  }

  .cmd-label {
    font-size: 12px;
    color: var(--ink-2);
  }

  .copy-btn {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    height: 26px;
