---
import { getImage } from 'astro:assets';
import laptop from '../assets/office/desk-laptop.png';
import mini from '../assets/office/desk-mini.png';
import chair from '../assets/office/chair.png';
import blanket from '../assets/office/props/blanket.webp';
import zzz from '../assets/office/props/zzz.webp';
import mug from '../assets/office/props/mug.webp';
import plant from '../assets/office/props/plant.webp';
import thought from '../assets/office/props/bubble-thought.webp';
import keycap from '../assets/office/props/keycap.webp';
import confetti from '../assets/office/props/confetti.webp';
import code from '../assets/office/screens/code.webp';
import chat from '../assets/office/screens/chat.webp';
import dashboard from '../assets/office/screens/dashboard.webp';
import done from '../assets/office/screens/done.webp';
import search from '../assets/office/screens/search.webp';

// A desk seen from behind: screen in the hole, desk, then the member in the chair.
type Screen = 'code' | 'chat' | 'dashboard' | 'done' | 'search' | 'off';
interface Props {
  setup: 'laptop' | 'mini';
  screen: Screen;
  figure?: string;
  pose?: 'work' | 'sleep' | 'cheer' | 'think';
  label: string;
}
const { setup, screen, figure, pose = 'work', label } = Astro.props;
// Each pose is a strip of eight frames, copied from the app's desk moves.
const strips = import.meta.glob<{ default: ImageMetadata }>('../assets/figures/*/desk/*.webp', { eager: true });
const strip = figure ? strips[`../assets/figures/${figure}/desk/${pose}.webp`]?.default : undefined;
const shots = { code, chat, dashboard, done, search } as Record<string, ImageMetadata>;

// Desk art is 440 wide, drawn at 220. Screen holes are corner quads in asset pixels;
// each screen covers its hole plus 1px and is clipped to it, so no bezel gap shows.
type Quad = [number, number][];
const geometry: Record<'laptop' | 'mini', { src: ImageMetadata; height: number; screens: Quad[]; mug: [number, number]; plant?: [number, number] }> = {
  laptop: {
    src: laptop,
    height: 283,
    mug: [336, 112],
    plant: [372, 96],
    screens: [
      [[145, 6], [297, 6], [296, 89], [146, 89]],
      [[39, 41], [112, 37], [116, 84], [42, 90]],
    ],
  },
  mini: {
    src: mini,
    height: 280,
    mug: [104, 122],
    screens: [[[127, 5], [315, 5], [315, 92], [127, 92]]],
  },
};
const k = 0.5;
const desk = geometry[setup];
const top = 164 - 18 - desk.height * k;
const box = (quad: Quad) => {
  const xs = quad.map(([x]) => x * k);
  const ys = quad.map(([, y]) => y * k);
  const l = Math.min(...xs) - 1;
  const t = Math.min(...ys) - 1;
  const clip = quad
    .map(([x, y], c) => `${x * k - l + [-1, 1, 1, -1][c]!}px ${y * k - t + [-1, -1, 1, 1][c]!}px`)
    .join(',');
  const w = Math.max(...xs) - l + 1;
  const h = Math.max(...ys) - t + 1;
  return `left:${l}px;top:${top + t}px;width:${w}px;height:${h}px;clip-path:polygon(${clip})`;
};
const at = ([x, y]: [number, number]) => `left:${x * k}px;top:${top + y * k}px`;
const lit = screen !== 'off';
// The desk and figure art ships as PNG; serve it as WebP.
const webp = async (m: ImageMetadata) => (await getImage({ src: m, format: 'webp' })).src;
const deskSrc = await webp(desk.src);
const chairSrc = await webp(chair);
// Desks in a row never move in step.
const phase = ([...label].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 11) % 997) / 997;
---
<div class="seat" data-screen={screen} data-pose={pose} title={label} style={`--phase:${phase}`}>
  <span class="floor"></span>
  <span class="screen" style={box(desk.screens[0]!)}>
    {lit && <img loading="lazy" decoding="async" src={shots[screen]!.src} alt="" data-kind={screen} />}
  </span>
  {desk.screens[1] && (
    <span class="screen side" style={box(desk.screens[1])}>
      {lit && <img loading="lazy" decoding="async" src={dashboard.src} alt="" />}
    </span>
  )}
  <img loading="lazy" decoding="async" class="desk" src={deskSrc} alt="" width="220" />
  {figure && lit && <img loading="lazy" decoding="async" class="prop" src={mug.src} alt="" style={`${at(desk.mug)};width:16px`} />}
  {desk.plant && <img loading="lazy" decoding="async" class="prop" src={plant.src} alt="" style={`${at(desk.plant)};width:22px`} />}
  {figure && pose === 'cheer' && <img loading="lazy" decoding="async" class="confetti" src={confetti.src} alt="" />}
  {strip ? (
    <span class="who" role="img" aria-label={label}>
      <span class="frames"><img loading="lazy" decoding="async" class="strip" src={strip.src} alt="" /></span>
      <img loading="lazy" decoding="async" class="back" src={chairSrc} alt="" />
    </span>
  ) : (
    <img loading="lazy" decoding="async" class="who chair" src={chairSrc} alt="" width="84.5" height="125" />
  )}
  {screen === 'code' && <img loading="lazy" decoding="async" class="key" src={keycap.src} alt="" />}
  {figure && !lit && <img loading="lazy" decoding="async" class="blanket" src={blanket.src} alt="" />}
  {figure && !lit && <img loading="lazy" decoding="async" class="zz" src={zzz.src} alt="" />}
  {pose === 'think' && <img loading="lazy" decoding="async" class="thought" src={thought.src} alt="" />}
</div>

<style>
  .seat {
    position: relative;
    flex: none;
    width: 220px;
    height: 164px;
  }

  .seat > * {
    position: absolute;
  }

  .floor {
    inset: 0;
  }

  .floor::before,
  .floor::after {
    position: absolute;
    content: '';
    background: radial-gradient(closest-side, rgb(var(--shade) / 20%), transparent);
    border-radius: 50%;
  }

  .floor::before {
    top: 134px;
    right: 6px;
    left: 6px;
    height: 22px;
    opacity: 0.55;
  }

  .floor::after {
    top: 148px;
    left: 78px;
    width: 64px;
    height: 14px;
    opacity: 0.8;
  }

  .screen {
    overflow: hidden;
    background: var(--screen-off);
  }

  .screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* Code scrolls while someone types. */
  .screen img[data-kind='code'] {
    height: auto;
    animation: scroll 9s linear infinite alternate;
  }

  .screen img[data-kind='search'] {
    animation: drift 6s ease-in-out infinite alternate;
  }

  .desk {
    bottom: 18px;
    left: 0;
    max-width: none;
    filter: var(--furniture);
  }

  .prop {
    filter: var(--furniture);
  }

  .who {
    top: 37px;
    left: 67.75px;
    width: 84.5px;
    height: 125px;
    filter: var(--sitter);
    transition: translate var(--d-slow) var(--ease-pop);
  }

  .seat:hover .who:not(.chair) {
    translate: 0 -3px;
  }

  .chair {
    rotate: 4deg;
  }

  /* The figure plays its pose as a strip of eight frames, with the chair drawn back over it.
     The frames carry a margin around the body, so they spill past the chair's box. */
  .frames {
    position: absolute;
    top: -3px;
    left: -5.75px;
    width: 96px;
    height: 128px;
    overflow: hidden;
  }

  .strip {
    --beat: 1.76s;

    display: block;
    width: 800%;
    max-width: none;
    height: 100%;
    animation: frames var(--beat) steps(8) infinite;
    animation-delay: calc(var(--phase) * -4s);
  }

  .seat[data-pose='think'] .strip {
    --beat: 2.08s;
  }

  .seat[data-pose='sleep'] .strip {
    --beat: 3.04s;
  }

  .seat[data-pose='cheer'] .strip {
    --beat: 1.2s;
  }

  .back {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .zz {
    top: 38px;
    left: 136px;
    width: 22px;
    opacity: 0;
    animation: zz 3s ease-out infinite;
  }

  /* Asleep under a blanket in front of a dark screen. */
  .blanket {
    top: 57px;
    left: 79px;
    width: 62px;
    filter: var(--sitter);
    transform-origin: 50% 100%;
    animation: breathe 3.6s ease-in-out infinite;
  }

  .thought {
    top: 2px;
    left: 140px;
    width: 34px;
    transform-origin: 0 100%;
    animation: ponder 2.4s ease-in-out infinite;
  }

  /* A key pops off the keyboard now and then. */
  .key {
    top: 68px;
    left: 146px;
    width: 9px;
    opacity: 0;
    animation: key 2.6s var(--ease) infinite;
    animation-delay: calc(var(--phase) * -2.6s);
  }

  .confetti {
    top: -14px;
    left: 82px;
    width: 56px;
    transform-origin: 50% 100%;
    animation: burst 2.4s var(--ease-pop) infinite;
  }

  /* Off screen, nothing moves. */
  :global(.js) .seat:not([data-near]) * {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .strip {
      animation: none !important;
    }
  }

  @keyframes frames {
    to { translate: -100%; }
  }

  @keyframes scroll {
    to { transform: translateY(-60%); }
  }

  @keyframes drift {
    to { transform: translateY(-14%); }
  }

  @keyframes zz {
    0% {
      opacity: 0;
      transform: translate(0, 6px) scale(0.6);
    }

    30% { opacity: 1; }

    100% {
      opacity: 0;
      transform: translate(10px, -16px) scale(1.1);
    }
  }

  @keyframes breathe {
    50% { transform: scaleY(1.015) translateY(-0.5px); }
  }

  @keyframes ponder {
    50% { transform: translateY(-2px) scale(1.04); }
  }

  @keyframes key {
    0%, 60% {
      opacity: 0;
      transform: translateY(4px);
    }

    66% {
      opacity: 1;
      transform: translateY(-6px) rotate(-18deg);
    }

    82% {
      opacity: 1;
      transform: translateY(-9px) rotate(-40deg);
    }

    100% {
      opacity: 0;
      transform: translateY(-2px) rotate(-60deg);
    }
  }

  @keyframes burst {
    0% {
      opacity: 0;
      transform: translateY(10px) scale(0.4);
    }

    25%, 70% {
      opacity: 1;
      transform: none;
    }

    100% {
      opacity: 0;
      transform: translateY(-4px) scale(1.05);
    }
  }
</style>

<script>
  // Desks play only while they are on screen.
  const near = new IntersectionObserver((entries) => {
    for (const e of entries) e.target.toggleAttribute('data-near', e.isIntersecting);
  });
  document.querySelectorAll('.seat').forEach((el) => near.observe(el));
</script>
