---
import { Image } from 'astro:assets';
import codex from '../assets/brand/codex.svg?raw';
import claude from '../assets/brand/claude-code.svg?raw';
import pi from '../assets/brand/pi.svg?raw';
import feishu from '../assets/brand/feishu.svg';

// A member hangs from a wooden peg on a fabric lanyard. Position = the peg's center.
interface Props {
  name: string;
  role: string;
  avatar?: ImageMetadata;
  initial?: string;
  foot: 'codex' | 'claude-code' | 'pi' | 'feishu';
  footLabel?: string;
  status?: 'ok' | 'busy';
  lead?: boolean;
  scale?: number;
  strap?: number;
  tilt?: number;
  delay?: number;
  style?: string;
}
const { name, role, avatar, initial, foot, footLabel, status, lead, scale = 1, strap = 64, tilt = 0, delay = 0, style = '' } = Astro.props;
const marks = { codex, 'claude-code': claude, pi } as Record<string, string>;
const latin = /^[\x00-\x7f]+$/.test(role);
---
<div
  class="hang"
  data-lanyard={lead ? 'lead' : 'member'}
  style={`--u:${scale};--strap:${strap}px;--tilt:${tilt}deg;--delay:${delay}ms;${style}`}
>
  <span class="peg"></span>
  <span class="strap"></span>
  <span class="clip"></span>
  <article class="badge">
    <span class="slot"></span>
    <div class="avatar">
      {avatar ? (
        <Image src={avatar} alt="" width={176} height={176} />
      ) : (
        <span class="initial">{initial}</span>
      )}
      {status && <i class="dot" data-status={status}></i>}
    </div>
    <header class="name">{name}</header>
    <div class="role" data-latin={latin}>{role}</div>
    <footer class="foot">
      {foot === 'feishu' ? (
        <img src={feishu.src} alt="" width="14" height="14" />
      ) : (
        <span class="mark" set:html={marks[foot]} />
      )}
      <span>{footLabel ?? foot}</span>
    </footer>
  </article>
</div>

<style>
  .hang {
    --w: calc(150px * var(--u));
    --peg: calc(24px * var(--u));
    --band: calc(20px * var(--u));

    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: var(--w);
    margin: calc(var(--peg) / -2) 0 0 calc(var(--w) / -2);
    transform-origin: 50% calc(var(--peg) / 2);
    rotate: var(--tilt);
    animation: hang-in 1.1s var(--ease-pop) both;
    animation-delay: var(--delay);
  }

  .hang:hover {
    animation: swing 1.7s cubic-bezier(0.3, 0.7, 0.4, 1);
  }

  .peg {
    position: relative;
    z-index: 3;
    flex: none;
    width: var(--peg);
    height: var(--peg);
    background: radial-gradient(circle at 36% 30%, #f3d7aa 0, #d6a96a 48%, #a8763f 100%);
    border-radius: 50%;
    box-shadow:
      inset 0 -1px 1px rgb(80 45 10 / 35%),
      1px 3px 4px rgb(20 22 40 / 28%);
  }

  /* The band loops over the peg and narrows a little toward the clip. */
  .strap {
    position: relative;
    z-index: 2;
    flex: none;
    width: var(--band);
    height: var(--strap);
    margin-top: calc(var(--peg) * -0.62);
    background:
      linear-gradient(90deg, rgb(0 0 0 / 28%), transparent 22% 78%, rgb(0 0 0 / 28%)),
      repeating-linear-gradient(0deg, rgb(255 255 255 / 7%) 0 1px, transparent 1px 3px),
      var(--band-color);
    border-radius: calc(var(--band) / 2) calc(var(--band) / 2) 2px 2px;
    box-shadow: 2px 4px 6px -2px rgb(20 22 40 / 30%);
    clip-path: polygon(0 0, 100% 0, 86% 100%, 14% 100%);
  }

  .hang[data-lanyard='member'] {
    --band-color: #24262d;
  }

  .hang[data-lanyard='lead'] {
    --band-color: var(--lanyard-lead);
  }

  .clip {
    position: relative;
    z-index: 2;
    flex: none;
    width: calc(var(--band) * 0.9);
    height: calc(14px * var(--u));
    margin-top: -2px;
    margin-bottom: calc(-8px * var(--u));
    background: linear-gradient(90deg, #b9bcc5, #f4f5f8 40%, #d3d5dc 70%, #a4a7b1);
    border-radius: 3px 3px 5px 5px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 25%);
  }

  .badge {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: var(--w);
    height: calc(206px * var(--u));
    padding-top: calc(30px * var(--u));
    overflow: hidden;
    color: var(--ink);
    text-align: center;
    background: var(--card);
    border-radius: calc(14px * var(--u));
    box-shadow: var(--card-shadow);
    transition: background-color var(--d-slow) var(--ease);
  }

  .slot {
    position: absolute;
    top: calc(12px * var(--u));
    left: 50%;
    width: calc(24px * var(--u));
    height: calc(5px * var(--u));
    background: var(--slot-face);
    border-radius: 999px;
    box-shadow: inset 0 1px 1.5px rgb(0 0 0 / 35%);
    translate: -50% 0;
  }

  .avatar {
    position: relative;
    flex: none;
    width: calc(76px * var(--u));
    height: calc(76px * var(--u));
  }

  .avatar img,
  .initial {
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  .avatar img {
    object-fit: cover;
  }

  .initial {
    display: grid;
    place-items: center;
    font-size: calc(32px * var(--u));
    font-weight: 700;
    color: #fff;
    background: var(--accent);
  }

  .dot {
    position: absolute;
    right: calc(2px * var(--u));
    bottom: calc(2px * var(--u));
    width: calc(16px * var(--u));
    height: calc(16px * var(--u));
    background: var(--ok);
    border-radius: 50%;
    box-shadow: 0 0 0 calc(3px * var(--u)) var(--card);
  }

  .dot[data-status='busy'] {
    background: var(--busy);
  }

  .name {
    max-width: 86%;
    margin-top: calc(12px * var(--u));
    overflow: hidden;
    font-size: calc(19px * var(--u));
    font-weight: 600;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .role {
    margin-top: calc(3px * var(--u));
    font-size: calc(11.5px * var(--u));
    font-weight: 500;
    color: var(--ink-3);
  }

  .role[data-latin='true'] {
    font-size: calc(11.5px * var(--u));
  }

  .foot {
    display: flex;
    gap: calc(6px * var(--u));
    align-items: center;
    justify-content: center;
    width: calc(100% - 28px * var(--u));
    padding: calc(9px * var(--u)) 0 calc(11px * var(--u));
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: calc(11px * var(--u));
    color: var(--ink-3);
    white-space: nowrap;
    border-top: var(--hairline) solid var(--line-strong);
  }

  .foot img,
  .mark :global(svg) {
    width: calc(13px * var(--u));
    height: calc(13px * var(--u));
  }

  .mark {
    color: var(--ink-2);
  }

  @keyframes hang-in {
    0% {
      opacity: 0;
      transform: translateY(-36px) rotate(-3deg);
    }

    55% {
      opacity: 1;
      transform: rotate(2deg);
    }

    80% {
      transform: rotate(-0.8deg);
    }
  }

  @keyframes swing {
    14% { transform: rotate(2.4deg); }
    36% { transform: rotate(-1.6deg); }
    58% { transform: rotate(0.8deg); }
    80% { transform: rotate(-0.3deg); }
  }

  @keyframes breathe {
    50% { opacity: 0.45; }
  }
</style>
