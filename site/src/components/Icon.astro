---
// Line icons drawn on a 24px grid, 1.75 stroke.
type Name = 'github' | 'apple' | 'download' | 'chevron-down' | 'laptop' | 'mini' | 'studio' | 'search' | 'chat' | 'calendar' | 'doc' | 'contacts' | 'plus' | 'smile' | 'send' | 'check' | 'branch' | 'star' | 'grab';
interface Props { name: Name; size?: number; class?: string }
const { name, size = 18, class: cls } = Astro.props;
---
{name === 'github' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
)}
{name === 'apple' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.37 12.7c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.78-3.32-1.8-1.41-.14-2.76.83-3.47.83-.72 0-1.82-.81-2.99-.79-1.54.02-2.96.9-3.75 2.27-1.6 2.78-.41 6.89 1.15 9.14.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.78.74 2.99.72 1.24-.02 2.02-1.12 2.77-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.4-.92-2.42-3.66ZM14.1 5.95c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.67 1.37-.58.67-1.1 1.76-.96 2.8 1.02.08 2.06-.52 2.69-1.28Z"/></svg>
)}
{name !== 'github' && name !== 'apple' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {name === 'download' && <><path d="M12 4v11" /><path d="m7 10 5 5 5-5" /><path d="M5 20h14" /></>}
    {name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}
    {name === 'laptop' && <><rect x="4" y="5" width="16" height="11" rx="1.5" /><path d="M2 19h20" /></>}
    {name === 'mini' && <><rect x="3" y="9" width="18" height="7" rx="2.5" /><path d="M7 19h10" /><circle cx="17" cy="12.5" r=".6" fill="currentColor" /></>}
    {name === 'studio' && <><rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M12 16v4" /><path d="M8 20h8" /></>}
    {name === 'search' && <><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></>}
    {name === 'chat' && <path d="M5 18.5 3.5 21l.6-3.4A8 8 0 1 1 7 19.4Z" />}
    {name === 'calendar' && <><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M4 10h16M9 3v4M15 3v4" /></>}
    {name === 'doc' && <><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></>}
    {name === 'contacts' && <><circle cx="12" cy="9" r="3.5" /><path d="M5 20a7 7 0 0 1 14 0" /></>}
    {name === 'plus' && <><path d="M12 5v14M5 12h14" /></>}
    {name === 'smile' && <><circle cx="12" cy="12" r="8.5" /><path d="M8.5 14a4 4 0 0 0 7 0" /><path d="M9.5 9.5h.01M14.5 9.5h.01" /></>}
    {name === 'send' && <><path d="M21 3 10 14" /><path d="m21 3-7 18-4-7-7-4Z" /></>}
    {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
    {name === 'branch' && <><circle cx="6" cy="5" r="2" /><circle cx="6" cy="19" r="2" /><circle cx="18" cy="7" r="2" /><path d="M6 7v10M18 9a7 7 0 0 1-7 7H8" /></>}
    {name === 'star' && <path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9Z" />}
    {name === 'grab' && <><path d="M8 11V6.5a1.5 1.5 0 0 1 3 0V11" /><path d="M11 10V5a1.5 1.5 0 0 1 3 0v5" /><path d="M14 10V6.5a1.5 1.5 0 0 1 3 0V14a6 6 0 0 1-6 6h-.5A5.5 5.5 0 0 1 5 16.2L3.8 13a1.5 1.5 0 0 1 2.7-1.3L8 14" /></>}
  </svg>
)}
