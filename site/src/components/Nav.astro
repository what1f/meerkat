---
import { Image } from 'astro:assets';
import icon from '../assets/brand/app-icon.png';
import Icon from './Icon.astro';
import PullCord from './PullCord.astro';
import { dicts, pathFor, type Lang } from '../i18n';
import { repo, download } from '../site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang].nav;
const other: Lang = lang === 'zh' ? 'en' : 'zh';
---
<header class="nav" data-nav>
  <div class="wrap bar">
    <a class="brand" href={pathFor(lang)} aria-label={t.home}>
      <Image src={icon} alt="" width={64} height={64} class="icon" />
      <span>Lankide</span>
    </a>
    <nav class="links">
      <a class="link" href={pathFor(other)} hreflang={dicts[other].htmlLang} lang={dicts[other].htmlLang} title={t.switchTo}>
        {t.switchShort}
      </a>
      <a class="link" href={repo} rel="noopener">
        <Icon name="github" size={18} />
        <span class="hide-sm">{t.github}</span>
      </a>
      <a class="btn btn-primary btn-sm" href={download}>{t.download}</a>
    </nav>
  </div>
</header>
<PullCord label={t.theme} />

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    transition:
      background-color var(--d-slow) var(--ease),
      box-shadow var(--d-slow) var(--ease);
  }

  .nav[data-scrolled] {
    background: var(--glass);
    box-shadow: 0 0.5px 0 var(--line);
    backdrop-filter: saturate(1.6) blur(20px);
    -webkit-backdrop-filter: saturate(1.6) blur(20px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    padding-right: max(var(--gutter), 64px);
  }

  .brand {
    display: flex;
    gap: 10px;
    align-items: center;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .brand :global(.icon) {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    box-shadow: 0 0 0 0.5px var(--edge), 0 2px 6px -2px rgb(60 70 180 / 35%);
  }

  .links {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .link {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    height: 34px;
    padding: 0 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    border-radius: 999px;
    transition:
      color var(--d-fast) var(--ease),
      background-color var(--d-fast) var(--ease);
  }

  .link:hover {
    color: var(--ink);
    background: var(--hover);
  }

  .links .btn {
    margin-left: 6px;
  }

  @media (max-width: 560px) {
    .hide-sm {
      display: none;
    }

    .bar {
      padding-right: 52px;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const update = () => nav?.toggleAttribute('data-scrolled', scrollY > 8);
  update();
  addEventListener('scroll', update, { passive: true });
</script>
