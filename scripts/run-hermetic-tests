#!/usr/bin/env python3
"""Build Cargo's integration targets, then run independent crate suites together."""

import concurrent.futures
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def run_suite(target, environment):
    name, executable, _ = target
    result = subprocess.run([executable], cwd=ROOT, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True, env=environment)
    return name, result


def main():
    build = subprocess.Popen(
        ["cargo", "test", "--workspace", "--tests", "--examples", "--locked", "--no-run",
         "--features", "lankide-computer/test-support,lankide-harness/test-support",
         "--message-format=json"],
        cwd=ROOT, stdout=subprocess.PIPE, text=True,
    )
    suites = {}
    environment = os.environ.copy()
    # Share the CPU budget between processes instead of letting every harness
    # create a full machine's worth of scenario threads.
    environment.setdefault("RUST_TEST_THREADS", str(max(1, (os.cpu_count() or 1) // 3)))
    for line in build.stdout:
        event = json.loads(line)
        if event["reason"] == "compiler-message":
            rendered = event["message"].get("rendered")
            if rendered:
                print(rendered, file=sys.stderr, end="")
        if (event["reason"] == "compiler-artifact" and event.get("executable")
                and "example" in event["target"]["kind"]
                and event["target"]["name"] in {"runtime_daemon_e2e", "computer_daemon_e2e"}):
            environment["LANKIDE_E2E_HELPER_" + event["target"]["name"].upper()] = event["executable"]
        if (event["reason"] == "compiler-artifact" and event.get("executable")
                and "test" in event["target"]["kind"]):
            target = event["target"]
            source = Path(target["src_path"])
            # Start larger scenario suites first so short suites can overlap them.
            weight = sum(path.stat().st_size for path in source.parent.parent.glob("*.rs"))
            suites[event["executable"]] = (event["package_id"], event["executable"], weight)
    status = build.wait()
    if status:
        return status
    if not suites:
        print("[hermetic] no integration test executables were built", file=sys.stderr)
        return 1
    failed = False
    # Bound process concurrency; each native Rust test harness still runs its
    # scenario threads and owns its normal ignored/live-test behavior.
    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as executor:
        futures = [executor.submit(run_suite, target, environment)
                   for target in sorted(suites.values(), key=lambda target: target[2], reverse=True)]
        for future in concurrent.futures.as_completed(futures):
            name, result = future.result()
            print(f"[hermetic] {name}\n{result.stdout}", end="", flush=True)
            failed |= result.returncode != 0
    return int(failed)


if __name__ == "__main__":
    raise SystemExit(main())
