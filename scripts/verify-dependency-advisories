#!/usr/bin/env bash
# Audit production roots per target; unused platform/optional dependencies in
# Cargo.lock are not evidence that a shipped executable contains that code.
set -euo pipefail
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

audit() {
  local target="$1" product="$2" manifest
  local roots=(apps/machine/Cargo.toml apps/meerkat-cli/Cargo.toml)
  case "$target" in
    aarch64-apple-darwin|x86_64-apple-darwin|aarch64-unknown-linux-gnu|x86_64-unknown-linux-gnu|x86_64-pc-windows-msvc) ;;
    *) echo "Unsupported advisory target: $target" >&2; return 2 ;;
  esac
  case "$product" in
    desktop) roots+=(apps/desktop/Cargo.toml apps/daemon/Cargo.toml) ;;
    machine) ;;
    *) echo "Unknown advisory product: $product" >&2; return 2 ;;
  esac
  for manifest in "${roots[@]}"; do
    echo "[dependency-advisories] $target $manifest"
    local extra_args=()
    if [[ "$target" == *-linux-* && "$manifest" == "apps/desktop/Cargo.toml" ]]; then
      extra_args+=(--config "$ROOT_DIR/scripts/deny-linux-desktop.toml")
    fi
    cargo deny --manifest-path "$manifest" --target "$target" --locked \
      ${extra_args[@]+"${extra_args[@]}"} \
      check advisories --deny warnings
  done
}

if [[ $# == 0 ]]; then
  audit aarch64-apple-darwin desktop
  audit x86_64-apple-darwin desktop
  audit x86_64-unknown-linux-gnu desktop
  audit aarch64-unknown-linux-gnu desktop
  audit x86_64-pc-windows-msvc desktop
elif [[ $# == 2 ]]; then
  audit "$1" "$2"
else
  echo 'usage: verify-dependency-advisories [RUST_TARGET desktop|machine]' >&2
  exit 2
fi
