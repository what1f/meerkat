#!/usr/bin/env python3
"""Bind release acceptance to exact source inputs and product executables."""

import argparse
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BINARIES = ("meerkat-desktop", "meerkatd", "meerkat-machine", "meerkat")


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def source_snapshot():
    files = [ROOT / "Cargo.toml", ROOT / "Cargo.lock", ROOT / "LICENSE", ROOT / "THIRD_PARTY_LICENSES.md"]
    if (ROOT / "Justfile").is_file():
        files.append(ROOT / "Justfile")
    for folder in (".cargo", "apps", "crates", "harnesses", "providers", "scripts", "tests", "licenses"):
        files.extend(path for path in (ROOT / folder).rglob("*")
                     if path.is_file()
                     and not path.is_relative_to(ROOT / "apps/desktop/gen")
                     and not path.is_relative_to(ROOT / "apps/web/dist")
                     and not {"target", "node_modules", "__pycache__"}.intersection(path.relative_to(ROOT).parts))
    return {str(path.relative_to(ROOT)): digest(path) for path in sorted(files)}


def binary_snapshot(directory):
    values = {}
    for name in BINARIES:
        path = directory / name
        if not path.is_file() or not path.stat().st_mode & 0o111:
            raise ValueError(f"release executable is missing: {name}")
        values[name] = digest(path)
    return values


def require_equal(expected, actual, label):
    changed = sorted(key for key in expected.keys() | actual.keys() if expected.get(key) != actual.get(key))
    if changed:
        raise ValueError(f"{label} changed: {', '.join(changed[:8])}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("snapshot", "record", "verify"))
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--binary-dir", type=Path)
    parser.add_argument("--source-snapshot", type=Path)
    args = parser.parse_args()
    if args.action == "snapshot":
        result = {"sources": source_snapshot()}
    elif args.binary_dir is None:
        parser.error("--binary-dir is required")
    elif args.action == "record":
        if args.source_snapshot is None:
            parser.error("--source-snapshot is required")
        result = json.loads(args.source_snapshot.read_text())
        require_equal(result["sources"], source_snapshot(), "build inputs")
        result["binaries"] = binary_snapshot(args.binary_dir)
    else:
        result = json.loads(args.output.read_text())
        require_equal(result["sources"], source_snapshot(), "build inputs")
        require_equal(result["binaries"], binary_snapshot(args.binary_dir), "release binaries")
        print("[release-provenance] PASS: source and executable SHA-256 match")
        return
    args.output.write_text(json.dumps(result, sort_keys=True, indent=2) + "\n")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError) as error:
        raise SystemExit(f"[release-provenance] FAIL: {error}")
