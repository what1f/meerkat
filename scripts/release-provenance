#!/usr/bin/env python3
"""Bind release acceptance to exact source inputs and product executables."""

import argparse
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BINARIES = ("meerkat-desktop", "meerkatd", "meerkat-machine", "meerkat", "meerkat-agent")


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def source_snapshot():
    files = [ROOT / "Cargo.toml", ROOT / "Cargo.lock", ROOT / "rust-toolchain.toml", ROOT / "LICENSE", ROOT / "THIRD_PARTY_LICENSES.md"]
    if (ROOT / "Justfile").is_file():
        files.append(ROOT / "Justfile")
    for folder in (".github", ".cargo", "apps", "crates", "harnesses", "providers", "scripts", "tests", "tools", "licenses"):
        files.extend(path for path in (ROOT / folder).rglob("*")
                     if path.is_file()
                     and not path.is_relative_to(ROOT / "apps/desktop/gen")
                     and not path.is_relative_to(ROOT / "apps/web/dist")
                     and not {"target", "node_modules", "__pycache__"}.intersection(path.relative_to(ROOT).parts))
    return {path.relative_to(ROOT).as_posix(): digest(path) for path in sorted(files)}


def binary_snapshot(directory, allow_missing_builtin_agent=False):
    values = {}
    is_windows = any((directory / f"{name}.exe").is_file() for name in BINARIES)
    suffix = ".exe" if is_windows else ""
    # Only Windows builds may omit the optional built-in Zig agent binary.
    optional_agent = is_windows and allow_missing_builtin_agent
    for name in BINARIES:
        path = directory / f"{name}{suffix}"
        if not path.is_file():
            if name == "meerkat-agent" and optional_agent:
                continue
            raise ValueError(f"release executable is missing: {name}{suffix}")
        if not is_windows and not path.stat().st_mode & 0o111:
            raise ValueError(f"release executable is missing: {name}")
        values[name] = digest(path)
    return values


def require_equal(expected, actual, label):
    changed = sorted(key for key in expected.keys() | actual.keys() if expected.get(key) != actual.get(key))
    if changed:
        raise ValueError(f"{label} changed: {', '.join(changed[:8])}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("snapshot", "record", "verify"))
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--binary-dir", type=Path)
    parser.add_argument("--source-snapshot", type=Path)
    parser.add_argument("--allow-missing-builtin-agent", action="store_true")
    args = parser.parse_args()
    if args.action == "snapshot":
        result = {"sources": source_snapshot()}
    elif args.binary_dir is None:
        parser.error("--binary-dir is required")
    elif args.action == "record":
        if args.source_snapshot is None:
            parser.error("--source-snapshot is required")
        result = json.loads(args.source_snapshot.read_text(encoding="utf-8"))
        require_equal(result["sources"], source_snapshot(), "build inputs")
        result["binaries"] = binary_snapshot(args.binary_dir, args.allow_missing_builtin_agent)
    else:
        result = json.loads(args.output.read_text(encoding="utf-8"))
        is_windows = any((args.binary_dir / f"{name}.exe").is_file() for name in BINARIES)
        allow_missing = is_windows and (args.allow_missing_builtin_agent or "meerkat-agent" not in result.get("binaries", {}))
        require_equal(result["sources"], source_snapshot(), "build inputs")
        require_equal(result["binaries"], binary_snapshot(args.binary_dir, allow_missing), "release binaries")
        print("[release-provenance] PASS: source and executable SHA-256 match")
        return
    args.output.write_text(json.dumps(result, sort_keys=True, indent=2) + "\n", encoding="utf-8")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError) as error:
        raise SystemExit(f"[release-provenance] FAIL: {error}")
