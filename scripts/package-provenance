#!/usr/bin/env python3
"""Bind a signed bundle/archive to the exact build copied before signing."""

import argparse
import hashlib
import json
from pathlib import Path, PurePosixPath
import runpy
import stat
import zipfile

ROOT = Path(__file__).resolve().parent.parent
LAYOUT = {
    "meerkat-desktop": "Contents/MacOS/Meerkat",
    "meerkatd": "Contents/Library/LaunchServices/meerkatd",
    "meerkat-machine": "Contents/Library/LaunchServices/meerkat-machine",
    "meerkat": "Contents/Resources/bin/meerkat",
}


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def bundle_snapshot(bundle):
    values = {}
    for path in sorted(bundle.rglob("*")):
        if path.is_symlink():
            raise ValueError("product bundle must not contain symlinks")
        if path.is_file():
            values[path.relative_to(bundle).as_posix()] = {"sha256": digest(path), "mode": stat.S_IMODE(path.stat().st_mode)}
    for relative in (
        *LAYOUT.values(),
        "Contents/Info.plist",
        "Contents/Resources/AppIcon.icns",
        "Contents/Resources/LICENSE",
        "Contents/Resources/THIRD_PARTY_LICENSES.md",
        "Contents/Library/LaunchAgents/com.meerkat.daemon.plist",
        "Contents/Library/LaunchAgents/com.meerkat.machine.plist",
    ):
        if relative not in values:
            raise ValueError(f"bundle file missing: {relative}")
    return values


def verify_archive(archive, bundle, expected):
    seen = set()
    with zipfile.ZipFile(archive) as zipped:
        for info in zipped.infolist():
            path = PurePosixPath(info.filename)
            if path.is_absolute() or ".." in path.parts or "\\" in info.filename:
                raise ValueError("unsafe archive member")
            mode = info.external_attr >> 16
            if stat.S_ISLNK(mode) or stat.S_IFMT(mode) not in (0, stat.S_IFREG, stat.S_IFDIR):
                raise ValueError("archive contains a non-regular member")
            if info.is_dir():
                continue
            if path.parts and path.parts[0] == "__MACOSX" and path.name.startswith("._"):
                continue
            if not path.parts or path.parts[0] != bundle.name:
                raise ValueError("archive file is outside the product bundle")
            relative = PurePosixPath(*path.parts[1:]).as_posix()
            if relative in seen or relative not in expected:
                raise ValueError("duplicate or unexpected archive member")
            seen.add(relative)
            if hashlib.sha256(zipped.read(info)).hexdigest() != expected[relative]["sha256"]:
                raise ValueError(f"archive differs from signed bundle: {relative}")
            if stat.S_IMODE(mode) != expected[relative]["mode"]:
                raise ValueError(f"archive permissions differ: {relative}")
    if seen != set(expected):
        raise ValueError("archive is missing signed bundle files")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("stage", "record", "verify"))
    parser.add_argument("--binary-dir", required=True, type=Path)
    parser.add_argument("--build-provenance", required=True, type=Path)
    parser.add_argument("--bundle", required=True, type=Path)
    parser.add_argument("--archive", type=Path)
    parser.add_argument("--stage", type=Path)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()
    provenance = runpy.run_path(str(ROOT / "scripts/release-provenance"))
    build = json.loads(args.build_provenance.read_text())
    provenance["require_equal"](build["sources"], provenance["source_snapshot"](), "build sources")
    provenance["require_equal"](build["binaries"], provenance["binary_snapshot"](args.binary_dir), "build binaries")
    if args.action == "stage":
        # This receipt is recorded immediately after copying, before codesign
        # is allowed to transform signature sections in the packaged copies.
        for name, relative in LAYOUT.items():
            if digest(args.bundle / relative) != build["binaries"][name]:
                raise ValueError(f"staged executable differs from verified build: {name}")
        result = {"build_sha256": digest(args.build_provenance), "binary_inputs": build["binaries"]}
    elif args.action == "record":
        if args.stage is None:
            parser.error("record requires --stage")
        result = json.loads(args.stage.read_text())
        if result != {"build_sha256": digest(args.build_provenance), "binary_inputs": build["binaries"]}:
            raise ValueError("build changed after package staging")
        result["bundle_files"] = bundle_snapshot(args.bundle)
        if args.archive:
            verify_archive(args.archive, args.bundle, result["bundle_files"])
            result["archive_sha256"] = digest(args.archive)
    else:
        result = json.loads(args.output.read_text())
        if result["build_sha256"] != digest(args.build_provenance) or result["binary_inputs"] != build["binaries"]:
            raise ValueError("package does not belong to this verified build")
        if result["bundle_files"] != bundle_snapshot(args.bundle):
            raise ValueError("signed bundle changed after packaging")
        if args.archive is None or result.get("archive_sha256") != digest(args.archive):
            raise ValueError("verified archive is missing or changed")
        verify_archive(args.archive, args.bundle, result["bundle_files"])
        print("[package-provenance] PASS: exact build, signed bundle and archive content match")
        return
    args.output.write_text(json.dumps(result, sort_keys=True, indent=2) + "\n")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, zipfile.BadZipFile) as error:
        raise SystemExit(f"[package-provenance] FAIL: {error}")
