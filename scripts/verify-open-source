#!/usr/bin/env python3
"""Verify the repository can be published without private data or copyleft dependencies."""

import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
REQUIRED = (
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "THIRD_PARTY_LICENSES.md",
    "licenses/Apache-2.0.txt",
    ".env.example",
)
FORBIDDEN_PATHS = (
    ".env",
    "project.tar.gz",
    "legacy",
)
TEXT_SUFFIXES = {
    "",
    ".json",
    ".md",
    ".py",
    ".rs",
    ".sh",
    ".toml",
    ".tsv",
    ".txt",
    ".yml",
    ".yaml",
}
PRIVATE_PATTERNS = (
    re.compile(r"/" r"Users/(?!\$|USERNAME\b|example\b|your-name\b)[^/\s\"']+"),
    re.compile(r"\b(?:oc|ou)_[0-9a-f]{20,}\b"),
    re.compile(r"\bteam-[0-9a-f]{32,}\b"),
)
COPYLEFT_LICENSES = ("GPL", "AGPL", "SSPL")
# Ignored dependency and build trees of the frontend packages.
GENERATED = {
    ROOT / "apps/web/node_modules",
    ROOT / "apps/web/dist",
    ROOT / "site/node_modules",
    ROOT / "site/dist",
    ROOT / "site/.astro",
}


def repository_entries():
    # Prune build/VCS trees before traversal, while still inspecting symlinks
    # (including directory symlinks) without following them.
    for directory, directories, files in os.walk(ROOT, followlinks=False):
        directories[:] = [name for name in directories if name not in {".git", "target"}
                          and Path(directory) / name not in GENERATED]
        for name in directories + files:
            if name in {".git", "target"} or Path(directory) / name in GENERATED:
                continue
            yield Path(directory) / name


def requires_copyleft(license_id: str) -> bool:
    """Return true when every SPDX OR choice contains a blocked license."""
    choices = license_id.upper().replace("(", "").replace(")", "").split(" OR ")
    return all(any(blocked in choice for blocked in COPYLEFT_LICENSES) for choice in choices)


def main() -> int:
    errors = []
    for relative in REQUIRED:
        if not (ROOT / relative).is_file():
            errors.append(f"missing required public file: {relative}")
    for relative in FORBIDDEN_PATHS:
        if (ROOT / relative).exists():
            errors.append(f"private or non-redistributable path present: {relative}")

    for path in repository_entries():
        if path.is_symlink():
            target = os.readlink(path)
            if os.path.isabs(target) or not path.resolve().exists():
                errors.append(f"non-portable symlink: {path.relative_to(ROOT)} -> {target}")
        if not path.is_file() or path.suffix.lower() not in TEXT_SUFFIXES:
            continue
        try:
            content = path.read_text()
        except UnicodeDecodeError:
            continue
        for pattern in PRIVATE_PATTERNS:
            if pattern.search(content):
                errors.append(f"private identifier in {path.relative_to(ROOT)}")

    try:
        result = subprocess.run(
            ["cargo", "metadata", "--locked", "--format-version", "1"],
            cwd=ROOT,
            check=True,
            capture_output=True,
            text=True,
        )
        metadata = json.loads(result.stdout)
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError) as error:
        errors.append(f"cargo metadata failed: {error}")
        metadata = {"packages": [], "workspace_members": []}

    packages = metadata["packages"]
    for package in packages:
        license_id = package.get("license")
        if license_id and requires_copyleft(license_id):
            errors.append(f"copyleft dependency remains: {package['name']} ({license_id})")
        if not license_id:
            errors.append(f"dependency has no license metadata: {package['name']}")

    workspace_members = set(metadata["workspace_members"])
    for package in packages:
        if package["id"] in workspace_members and package.get("publish") != []:
            errors.append(f"workspace package is publishable by default: {package['name']}")

    if errors:
        print("[open-source] FAIL", file=sys.stderr)
        print("\n".join(sorted(set(errors))), file=sys.stderr)
        return 1
    print(f"[open-source] PASS ({len(packages)} resolved packages; public files, paths, symlinks, licenses)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
