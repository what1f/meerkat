#!/bin/zsh
set -euo pipefail

ROOT_DIR="${0:A:h:h}"
BUSINESS_UI="$ROOT_DIR/apps/desktop/src/ui"

if ! command -v rg >/dev/null; then
  print -u2 "[desktop-ui-boundary] ripgrep (rg) is required"
  exit 1
fi

# Product code may use gpui-component state and business-specific overlays,
# but ordinary visual controls must be constructed by desktop-ui.
forbidden='\b(Button|Checkbox|Input|Textarea|Select|Dialog)::(new|default)'
if rg -n "$forbidden" "$BUSINESS_UI" --glob '*.rs'; then
  print -u2 "[desktop-ui-boundary] business UI constructs a standard control directly"
  exit 1
fi

# ui-preview is the executable contract for the shared component crate, so it
# must demonstrate the same public wrappers instead of styling substitutes.
if rg -n "$forbidden" "$ROOT_DIR/apps/ui-preview/src" --glob '*.rs'; then
  print -u2 "[desktop-ui-boundary] ui-preview bypasses a desktop-ui standard control"
  exit 1
fi

print "[desktop-ui-boundary] PASS"
