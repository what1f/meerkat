#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
[[ "${LANKIDE_E2E_LIVE:-}" == 1 ]] || { printf 'PREREQUISITE_MISSING: explicit live opt-in required\n' >&2; exit 4; }
[[ -n "${LANKIDE_E2E_RUN_ID:-}" ]] || { printf 'PREREQUISITE_MISSING: unique run id required\n' >&2; exit 4; }
[[ -x "${LANKIDE_E2E_LARK_CLI:-}" ]] || { printf 'PREREQUISITE_MISSING: LANKIDE_E2E_LARK_CLI must point to the official CLI\n' >&2; exit 4; }
profile=(--profile test)
if [[ -n "${LANKIDE_RELEASE_BIN_DIR:-}" ]]; then
  profile=(--release)
  for binary in lankide-runtime-daemon lankide-computer-daemon lankide; do
    [[ -x "$LANKIDE_RELEASE_BIN_DIR/$binary" ]] || { printf 'release composition binary missing: %s\n' "$binary" >&2; exit 4; }
  done
  LANKIDE_E2E_COMPUTER_BIN="$LANKIDE_RELEASE_BIN_DIR/lankide-computer-daemon"
else
  [[ "${LANKIDE_RELEASE_REQUIRED:-}" != 1 ]] || { printf 'release binary directory missing\n' >&2; exit 4; }
  cargo build --locked -p lankide-runtime-daemon -p lankide-computer-daemon -p lankide-cli
  LANKIDE_E2E_COMPUTER_BIN="${CARGO_TARGET_DIR:-$ROOT_DIR/target}/debug/lankide-computer-daemon"
fi
export LANKIDE_E2E_COMPUTER_BIN
cargo test --locked "${profile[@]}" -p lankide-runtime-daemon --test e2e live_provider_management_e2e:: -- --ignored --nocapture
cargo test --locked "${profile[@]}" -p lankide-runtime-daemon --test e2e feishu_team_live_e2e:: -- --ignored --nocapture
