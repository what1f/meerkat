#!/usr/bin/env python3

"""Fail when the machine-readable E2E manifest and Cargo metadata diverge."""

from __future__ import annotations

import csv
import json
import re
import shlex
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
MANIFEST = ROOT / "tests" / "e2e-modules.tsv"
FIELDS = (
    "command",
    "scenario",
    "prerequisites",
    "classification",
    "unattended",
    "status",
)


def fail(message: str) -> None:
    print(f"[e2e-contracts] {message}", file=sys.stderr)


def main() -> int:
    with MANIFEST.open(newline="", encoding="utf-8") as stream:
        rows = list(csv.DictReader(stream, delimiter="\t"))

    metadata = json.loads(
        subprocess.check_output(
            ["cargo", "metadata", "--no-deps", "--format-version", "1"],
            cwd=ROOT,
            text=True,
        )
    )
    packages = {package["name"]: package for package in metadata["packages"]}

    errors = 0
    for package in packages.values():
        targets = [target for target in package["targets"] if "test" in target["kind"]]
        if not targets:
            continue
        if len(targets) != 1 or targets[0]["name"] != "e2e":
            fail(f"{package['name']}: expected one consolidated e2e target")
            errors += 1
            continue
        suite = Path(targets[0]["src_path"])
        modules = set(re.findall(r"^mod (\w+);", suite.read_text(), re.MULTILINE))
        scenarios = {path.stem for path in suite.parent.parent.glob("*.rs")}
        if scenarios - modules:
            fail(f"{package['name']}: scenarios missing from suite: {sorted(scenarios - modules)}")
            errors += 1
    module_ids: set[str] = set()
    package_names: set[str] = set()
    primary_packages: set[str] = set()
    additional_contracts: set[tuple[str, str]] = set()
    for row in rows:
        module_id = row["# module_id"]
        package_name = row["package"]
        if module_id in module_ids:
            fail(f"duplicate module id: {module_id}")
            errors += 1
        module_ids.add(module_id)
        package_names.add(package_name)

        package = packages.get(package_name)
        if package is None:
            fail(f"{module_id}: Cargo package not found: {package_name}")
            errors += 1
            continue
        contracts = (package.get("metadata") or {}).get("meerkat", {})
        additional = contracts.get("e2e-additional", {})
        if module_id in additional:
            contract = additional[module_id]
            additional_contracts.add((package_name, module_id))
        else:
            contract = contracts.get("e2e")
            if package_name in primary_packages:
                fail(f"duplicate primary package row: {package_name}")
                errors += 1
            primary_packages.add(package_name)
        if not isinstance(contract, dict):
            fail(f"{module_id}: missing package.metadata.meerkat.e2e")
            errors += 1
            continue
        tokens = shlex.split(row["command"])
        for index, token in enumerate(tokens):
            if token != "--test":
                continue
            # A focused command can build a helper before starting Cargo tests.
            prefix = tokens[:index]
            package_index = max(i for i, value in enumerate(prefix) if value == "-p")
            target_package = packages[prefix[package_index + 1]]
            name = tokens[index + 1]
            target = next((target for target in target_package["targets"]
                           if "test" in target["kind"] and target["name"] == name), None)
            if target is None:
                fail(f"{module_id}: unknown test target {name}")
                errors += 1
            elif index + 2 < len(tokens) and tokens[index + 2].endswith("::"):
                module = tokens[index + 2][:-2]
                source = Path(target["src_path"]).read_text()
                if not re.search(rf"^mod {re.escape(module)};", source, re.MULTILINE):
                    fail(f"{module_id}: unknown scenario module {module}")
                    errors += 1
        for field in FIELDS:
            manifest_value = row[field]
            metadata_value = contract.get(field)
            if metadata_value != manifest_value:
                fail(
                    f"{module_id}.{field} differs: manifest={manifest_value!r} "
                    f"metadata={metadata_value!r}"
                )
                errors += 1

    for package_name, package in packages.items():
        additional = (package.get("metadata") or {}).get("meerkat", {}).get("e2e-additional", {})
        for module_id in additional:
            if (package_name, module_id) not in additional_contracts:
                fail(f"{module_id}: additional E2E contract has no manifest row")
                errors += 1

    unlisted = sorted(
        package_name
        for package_name, package in packages.items()
        if (package.get("metadata") or {}).get("meerkat", {}).get("e2e")
        and package_name not in primary_packages
    )
    for package_name in unlisted:
        fail(f"Cargo package has an E2E contract but no manifest row: {package_name}")
        errors += 1

    for name, package in packages.items():
        if name in package_names:
            continue
        metadata = (package.get("metadata") or {}).get("meerkat", {})
        exemption = metadata.get("e2e-exemption")
        if name == "meerkat-web-types" and isinstance(exemption, str) and exemption.strip():
            continue
        if name not in unlisted:
            fail(f"workspace package lacks an E2E contract: {name}")
            errors += 1

    if errors:
        fail(f"FAIL ({errors} contract mismatch(es))")
        return 1
    print(f"[e2e-contracts] PASS ({len(rows)} module contracts synchronized)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
